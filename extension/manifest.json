{
  "manifest_version": 3,
  "name": "Genshin Helper — HoYoLAB Auto-Sync",
  "version": "5.7.0",
  "key": "",
  "description": "Đồng bộ vị trí người chơi Genshin Impact thời gian thực lên HoYoLAB Interactive Map (Zero-Throttle MV3).",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://act.hoyolab.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "optional_host_permissions": [
    "https://genshin-impact-map.appsample.com/*",
    "https://v3.yuanshen.site/*",
    "https://yuanshen.site/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Genshin Helper — HoYoLAB Auto-Sync",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://act.hoyolab.com/*"
      ],
      "js": [
        "route_hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://act.hoyolab.com/*"
      ],
      "js": [
        "content_bridge.js",
        "i18n_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://act.hoyolab.com/*"
      ],
      "js": [
        "i18n.js",
        "page_main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "locales/vi.json",
        "locales/en.json"
      ],
      "matches": [
        "https://act.hoyolab.com/*"
      ]
    }
  ]
}
